# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration (Updated API Keys Interface)
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable Key (Client-side / Browser - supports both new sb_publishable_* keys and legacy anon keys):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Legacy fallback (optional):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Secret Key (Server-side only / Service Role - supports both new sb_secret_* keys and legacy service_role keys):
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy fallback (optional):
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key

# Backblaze B2 S3-Compatible Storage
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_ACCESS_KEY_ID=your_key_id
B2_SECRET_ACCESS_KEY=your_secret_key
B2_BUCKET_NAME=your_bucket_name

# Supabase Auth OAuth Providers (Used by `supabase start` / `supabase/deploy-edu-claude.sh`; never exposed to clients)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_oauth_client_id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=your_apple_service_id
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your_apple_client_secret_jwt
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=your_github_oauth_client_id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=your_github_oauth_client_secret

